{
  "$schema": "https://developer.microsoft.com/en-us/json-schemas/teams/v1.25/MicrosoftTeams.schema.json",
  "version": "1.1.0",
  "manifestVersion": "1.25",
  "id": "26796e6a-d79f-4739-8426-45b3a07b64bb",
  "name": {
    "short": "Sucafina Sample Manager",
    "full": "Sucafina Sample Manager (Lua)"
  },
  "developer": {
    "name": "Lua Global Inc.",
    "websiteUrl": "https://heylua.ai",
    "privacyUrl": "https://heylua.ai/privacy-policy/",
    "termsOfUseUrl": "https://heylua.ai/terms-of-service/"
  },
  "description": {
    "short": "Sample desk assistant for Quality and Trade — log, dispatch and track coffee samples from Teams.",
    "full": "Sucafina Sample Manager logs sample requests, routes missing details to the colleague who has them, pings Quality when a request is complete, and keeps traders posted as samples are prepared, dispatched and tracked.\n\nMessage it 1:1, or forward a sample request to a colleague AND this bot to start a group chat: it reads the chat (including messages from before it was added), knows who asked, and answers when mentioned.\n\nPowered by Lua (heylua.ai)."
  },
  "icons": {
    "outline": "outline.png",
    "color": "color.png"
  },
  "accentColor": "#FFFFFF",
  "bots": [
    {
      "botId": "966fbc34-e124-4123-bb03-56abfb1e77a3",
      "scopes": [
        "groupChat",
        "personal",
        "team"
      ],
      "isNotificationOnly": false,
      "supportsCalling": false,
      "supportsVideo": false,
      "supportsFiles": false
    }
  ],
  "validDomains": [],
  "webApplicationInfo": {
    "id": "966fbc34-e124-4123-bb03-56abfb1e77a3"
  },
  "authorization": {
    "permissions": {
      "resourceSpecific": [
        {
          "name": "ChatMessage.Read.Chat",
          "type": "Application"
        },
        {
          "name": "ChatMember.Read.Chat",
          "type": "Application"
        },
        {
          "name": "ChatSettings.Read.Chat",
          "type": "Application"
        },
        {
          "name": "ChannelMessage.Read.Group",
          "type": "Application"
        },
        {
          "name": "TeamMember.Read.Group",
          "type": "Application"
        }
      ]
    }
  },
  "supportsChannelFeatures": "tier1"
}
