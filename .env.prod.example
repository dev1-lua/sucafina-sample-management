# Copy to `.env.prod` ON THE VPS and fill with real values. Do NOT commit .env.prod.
# Consumed by: docker compose -f docker-compose.prod.yml --env-file .env.prod up -d --build

# Strong Postgres password (internal-only; Postgres is never published to the host).
DB_PASSWORD=REPLACE_WITH_A_STRONG_DB_PASSWORD

# API key the frontend + agent must send as `x-api-key`. NOTE: the frontend embeds this
# in its JS bundle, so it is a light gate, not a true secret (see DEPLOY.md security note).
API_KEY=REPLACE_WITH_A_STRONG_API_KEY

# The public hostname (sucafina-api.luameet.in) is served by your EXISTING Caddy, not by
# this stack — so there is no API_DOMAIN here. See DEPLOY.md step 5 for the Caddy route.

# DHL "Shipment Tracking – Unified" API key (developer.dhl.com). Leave blank until the key
# arrives — blank means "live tracking not configured", never fabricated.
DHL_API_KEY=

# FedEx Track API OAuth client id (developer.fedex.com). Leave blank until it arrives.
FEDEX_CLIENT_ID=

# FedEx Track API OAuth client secret. Leave blank until it arrives.
FEDEX_CLIENT_SECRET=

# FedEx API base: sandbox https://apis-sandbox.fedex.com, prod https://apis.fedex.com.
FEDEX_API_BASE=https://apis-sandbox.fedex.com

# Max DHL tracking calls per UTC day (in-memory counter, resets on restart).
TRACKING_DHL_DAILY_CAP=200

# Fall back to the deterministic stub provider in production when a courier's key is
# missing. Keep false in prod so a missing key surfaces as "not configured" instead of
# fake tracking data.
TRACKING_STUB_FALLBACK=false
